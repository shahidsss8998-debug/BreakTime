# ============================================
# Break Time Cafe — Backend Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.
# ============================================

# ── Server ──
PORT=5000
NODE_ENV=development

# ── Frontend Origin (for CORS) ──
# Local development:
FRONTEND_URL=http://localhost:5173
# Production (your Netlify domain):
# FRONTEND_URL=https://your-app.netlify.app

# ── Gmail SMTP Credentials ──
EMAIL_USER=breaktime7092@gmail.com
EMAIL_PASS=owjmzmltmkyzxnej

# ── Admin Notification Recipient ──
ADMIN_EMAIL=breaktime7092@gmail.com

# ── Firebase Admin SDK Credentials ──
# Get these from Firebase Console → Project Settings → Service Accounts → Generate New Private Key
FIREBASE_PROJECT_ID=raihan-cafe
FIREBASE_CLIENT_EMAIL=your-service-account@raihan-cafe.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
