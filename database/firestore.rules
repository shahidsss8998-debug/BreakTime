rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users Collection ──
    // Customers can only read/write their own profile document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Admins Collection ──
    // Anyone authenticated can create an admin doc (gated by registration code in app logic).
    // Only the admin themselves can read their own document.
    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow create: if request.auth != null;
    }

    // ── Orders Collection ──
    // Customers can create orders (must be authenticated).
    // Customers can read only their own orders.
    // Admins (verified via admins collection) can read all orders and update status.
    match /orders/{orderId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null &&
        (resource == null ||
         resource.data.customerId == request.auth.uid ||
         exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
      allow delete: if request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow update: if request.auth != null && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (resource.data.customerId == request.auth.uid && request.resource.data.status == 'cancelled' && resource.data.status == 'placed') ||
        (resource.data.customerId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['customerHidden']))
      );
    }

    // ── Menu Collection ──
    // Anyone can read menu items (public).
    // Only admins can create/update/delete menu items.
    match /menu/{itemId} {
      allow read: if true;
      allow write: if request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
  }
}
